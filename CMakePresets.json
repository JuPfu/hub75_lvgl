{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "hub75_lvgl (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "HUB75_LVGL_FRESH_DEPS": "OFF"
      }
    },
    {
      "name": "fresh-deps",
      "displayName": "hub75_lvgl (re-fetch LVGL/hub75)",
      "inherits": "default",
      "cacheVariables": {
        "HUB75_LVGL_FRESH_DEPS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "jobs": 0
    },
    {
      "name": "fresh-deps",
      "configurePreset": "fresh-deps",
      "jobs": 0
    }
  ]
}